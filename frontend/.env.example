# Firebase Console → Configuración del proyecto → Tus apps → Aplicación web
# Estos identificadores configuran el cliente; las reglas de Firebase protegen los datos.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase Console → Realtime Database → URL de la base de datos
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
